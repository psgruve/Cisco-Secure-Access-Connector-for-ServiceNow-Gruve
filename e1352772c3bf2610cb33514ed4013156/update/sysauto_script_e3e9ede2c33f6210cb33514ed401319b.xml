        <script><![CDATA[(function executeTokenJob() {
    try {
        gs.info("[Cisco CSA] Token Refresh Job started at: " + new GlideDateTime());
 
        var tokenManager = new CiscoCSATokenManager();
        tokenManager.fetchAndStoreToken();
 
        gs.info("[Cisco CSA] Token refresh completed successfully at: " + new GlideDateTime());
    } catch (e) {
        gs.error("[Cisco CSA] Token refresh failed at: " + new GlideDateTime() + " | Error: " + e.message);
    }
})();]]></script>
