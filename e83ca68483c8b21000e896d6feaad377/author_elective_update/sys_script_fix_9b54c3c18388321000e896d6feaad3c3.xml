        <name>cisco secure access UI Policy field</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[(function executeFixScript() {
    var tableName = "change_request";
    var categoryValue = "CSA Configuration"; // must match sys_choice.value exactly

    // Check if UI Policy already exists
    var uiPolicy = new GlideRecord("sys_ui_policy");
    uiPolicy.addQuery("table", tableName);
    uiPolicy.addQuery("short_description", "Show Destination fields for Cisco Secure Access");
    uiPolicy.query();

    if (!uiPolicy.next()) {
        uiPolicy.initialize();
        uiPolicy.table = tableName;
        uiPolicy.short_description = "Show Destination fields for Cisco Secure Access";
        uiPolicy.conditions = "category=" + categoryValue; // encoded query string
        uiPolicy.on_load = true;
        uiPolicy.inherit = false;
        var uiPolicySysId = uiPolicy.insert();

        if (uiPolicySysId) {
            // Destination List field action
            var action1 = new GlideRecord("sys_ui_policy_action");
            action1.initialize();
            action1.ui_policy = uiPolicySysId;
            action1.field = "u_destination_list";
            action1.visible = true;  // use boolean
            action1.insert();

            // Destination Address field action
            var action2 = new GlideRecord("sys_ui_policy_action");
            action2.initialize();
            action2.ui_policy = uiPolicySysId;
            action2.field = "u_destination_address";
            action2.visible = true;  // use boolean
            action2.insert();
        }
    }
})();
]]></script>
