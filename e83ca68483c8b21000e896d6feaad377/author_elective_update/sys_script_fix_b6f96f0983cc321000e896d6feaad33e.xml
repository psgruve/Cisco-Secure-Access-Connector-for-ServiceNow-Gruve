        <script><![CDATA[(function executeFixScript() {
    var tableName = "change_request";

    function addToFormLayout(fieldName, label) {
        var section = new GlideRecord("sys_ui_section");
        // section.addQuery("name", tableName + ".default"); // default form
		section.addQuery("name", tableName);
        section.query();
        if (section.next()) {
            var item = new GlideRecord("sys_ui_element");
            item.addQuery("sys_ui_section", section.sys_id);
            item.addQuery("element", fieldName);
            item.query();
            if (!item.next()) {
                item.initialize();
                item.sys_ui_section = section.sys_id;
                item.element = fieldName;
                item.position = 999; // add at bottom
                item.insert();
                gs.print("]]>📋<![CDATA[ Added " + label + " to form layout.");
            } else {
                gs.print("ℹ️ " + label + " already exists on form layout.");
            }
        } else {
            gs.print("❌ Could not find form layout for " + tableName);
        }
    }

    addToFormLayout("u_destination_list", "Destination List");
    addToFormLayout("u_destination_address", "Destination Address");

    gs.print("]]>🎉<![CDATA[ Form layout update complete.");
})();
]]></script>
