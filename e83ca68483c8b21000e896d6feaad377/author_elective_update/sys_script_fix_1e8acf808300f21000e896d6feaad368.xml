<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_script_fix">
    <sys_script_fix action="DELETE">
        <before>false</before>
        <description>Adding chices in the change request form </description>
        <name>Cisco Secure Access Choices Change Req</name>
        <record_for_rollback>true</record_for_rollback>
        <script><![CDATA[(function executeFixScript() {
    var tableName = "change_request";
    var fieldName = "category";

    // list of choices
    var newChoices = [
        { value: "test_software", label: "Test Software", sequence: 100, inactive: false },
        { value: "test_hardware", label: "Test Hardware", sequence: 200, inactive: false },
        { value: "test_network", label: "Test Network", sequence: 300, inactive: false },
		{ value: "Cisco Secure Access2", label: "CSA Configuration2", sequence: 400, inactive: false},
		{ value: "CSA Configuration", label: "Cisco Secure Access", sequence: 400, inactive: false }
    ];

    newChoices.forEach(function(choice) {
        var gr = new GlideRecord("sys_choice");
        gr.addQuery("name", tableName);
        gr.addQuery("element", fieldName);
        gr.addQuery("value", choice.value);
        gr.query();

        if (!gr.next()) {
            var newGr = new GlideRecord("sys_choice");
            newGr.initialize();
            newGr.name = tableName;
            newGr.element = fieldName;
            newGr.value = choice.value;
            newGr.label = choice.label;
            newGr.sequence = choice.sequence;
            newGr.inactive = choice.inactive;
            newGr.language = "en";
            newGr.insert();

            gs.log("Fix Script: Inserted choice " + choice.label);
        } else {
            gs.log("Fix Script: Choice " + choice.label + " already exists");
        }
    });
})();
]]></script>
