	<body>
		<div class="form-container">

			<div class="stepper">
				<div class="progress-line" id="progressLine" style="width:20%"></div>
				<div class="step active" id="stepper1">
					<span class="circle">1</span>
					<p>Cisco Seure Access Credentials</p>
				</div>
				<div class="step" id="stepper2">
					<span class="circle">2</span>
					<p>Webhook</p>
				</div>
			</div>

			<div class="divider"></div>
			<!-- Step 1 -->
			<div id="step1">
				<h2>Cisco Seure Access App Credentials</h2>
				<form onsubmit="submitCSAConfig(); return false;">
					<div class="form-group">
						<label for="client_key">Client Key</label>
						<input class="form-control" type="text" id="client_key" name="client_key"
							placeholder="Enter your Client Key" required="required" />
					</div>
					<div class="form-group">
						<label for="client_secret">Client Secret</label>
						<input class="form-control" type="password" id="client_secret" name="client_secret"
							placeholder="Enter your Client Secret" required="required" />
					</div>
					<button type="submit" class="btn-primary">Submit</button>
				</form>
				<div id="result"></div>
			</div>

			<!-- Step 2 -->
			<div id="step2" style="display:none;">
				<h2>Webhook Credentials</h2>
				 <div class="instructions">
                <h3>Instructions</h3>
                <ol>
                    <li>Ask your administrator to create a dedicated ServiceNow user account for receiving CSA alerts.
                    </li>
                    <li>Note the ServiceNow Username and Password for the new account. Enter carefully; incorrect
                        credentials cannot be verified.</li>
                    <li>Fill in your credentials below and click Submit to register for CSA Event Alerts. A confirmation
                        message will appear upon success.</li>
                </ol>
            </div>
				<form onsubmit="submitForm(); return false;">
					<div class="form-group">
						<label for="username">Username</label>
						<input class="form-control" type="text" id="username" name="username" required="required" />
					</div>
					<div class="form-group">
						<label for="password">Password</label>
						<input class="form-control" type="password" id="password" name="password" required="required" />
					</div>
					<div class="form-group">
						<label for="cnf_password">Confirm Password</label>
						<input class="form-control" type="password" id="cnf_password" name="cnf_password"
							required="required" />
					</div>
					<button type="submit" class="btn-primary">Submit</button>
				</form>
				<div id="resultMsg"></div>
			</div>

		</div>
		<script>
			function setStepStatus(stepNum, status) {
    const stepEl = document.getElementById("stepper" + stepNum);
    stepEl.classList.remove("active", "completed");
 
    // Set the step status
    stepEl.classList.add(status); // 'active' or 'completed'
 
    // Update progress line width based on step number
    const progressLine = document.getElementById("progressLine");
    switch(stepNum) {
        case 1:
            progressLine.style.width = (status === "completed") ? "50%" : "20%";
            break;
        case 2:
            progressLine.style.width = (status === "completed") ? "100%" : "50%";
            break;
    }
}
 
 
function submitCSAConfig() {
    var clientKey = document.getElementById("client_key").value;
      var clientSecret = document.getElementById("client_secret").value;
 
      if (!clientKey || !clientSecret) {
        document.getElementById("result").innerHTML =
          '<div style="color:red;">❌ Please enter both Client Key and Secret.</div>';
        return;
      }
 
      var ga = new GlideAjax("CiscoSecureAccessCredentials");
      ga.addParam("sysparm_name", "createProfileAndFetchToken");
      ga.addParam("client_key", clientKey);
      ga.addParam("client_secret", clientSecret);
 
      document.getElementById("result").innerHTML =
        '<div style="color:orange;">⏳ Fetching token...</div>';
 
      ga.getXMLAnswer(function(response) {
        if (response) {
          document.getElementById("result").innerHTML =
            '<div style="color:green;">' + response + '</div>';
 
            setStepStatus(1, "completed");
            setStepStatus(2, "active");
           
            document.getElementById("step1").style.display = "none";
            document.getElementById("step2").style.display = "block";
        } else {
          document.getElementById("result").innerHTML =
            '<div style="color:red;">No response received. Check logs.</div>';
        }
      });
}
 
      window.onload = function() {
                const savedUsername = localStorage.getItem('savedUsername');
                if (savedUsername) {
                     document.getElementById('username').value = savedUsername;
                 }
        };
        async function submitForm() {
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('cnf_password').value;
            const resultDiv = document.getElementById('resultMsg');
            localStorage.setItem('savedUsername', username);
//  Step 1: Fetch Webhook where Events received in ServiceNow
    let apiInfo;
    try {
        apiInfo = await new Promise(function (resolve, reject) {
            var ga = new GlideAjax('CiscoSecureAccessGetWebhookUrl');
            ga.addParam('sysparm_name', 'getApiInfo'); // Script Include method
            ga.addParam('sysparm_api_name', 'Cisco Secure Access Event Management'); // API Name
            ga.getXMLAnswer(function (response) {
                try {
                    resolve(JSON.parse(response));
                } catch (e) {
                    reject(e);
                }
            });
        });
    } catch (err) {
        resultDiv.innerHTML = "Error fetching API info: " + err;
        resultDiv.className = 'error';
        return;
    }
 
    if (apiInfo.error) {
        resultDiv.innerHTML = apiInfo.error;
        resultDiv.className = 'error';
        return;
    }
 			const webhook = apiInfo.full_url;
			alert(webhook);
 			//  Step 2: Get latest token from table
            var tokenGR = new GlideRecord("u_cisco_secure_access_token");
            tokenGR.orderByDesc("sys_created_on");
            tokenGR.setLimit(1);
            tokenGR.query();
 
        if (!tokenGR.next()) {
			console.log("No access token found");
            gs.error("No access token found");
            return;
        }
   
        var accessToken = tokenGR.getValue("u_access_token");
        if (!accessToken) {
			console.log("No access token found");
            gs.error("Access token is empty");
            return;
        }
        resultDiv.innerHTML = '';
 			// Step 3: Validate password
            if (password !== confirmPassword) {
                resultDiv.innerHTML = "<span class='error'>Passwords do not match!</span>";
                return;
            }
 			// Step 4: Integration + Credentials
            try {
                const integrationPayload = {
                    type: "webhook.v1",
                    name: "SNOW Alert",
                    webhookConfig: { url: webhook }
                };
 
                const integrationResp = await fetch(" https://api.sse.cisco.com/admin/v2/integrations", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": "Bearer " + accessToken
                    },
                    body: JSON.stringify(integrationPayload)
                });
 
                if (!integrationResp.ok) {
                    throw new Error("Integration API failed: " + integrationResp.status);
                }
 
                const integrationData = await integrationResp.json();
                const href = integrationData.href;
				if (!href) throw new Error("No href found in integration response");
 
                const credentialsPayload = {
                    name: "Add credentials to webhook",
                    tags: ["string"],
                    type: "basic-auth",
                    value: { username, password }
                };
 
                const credResp = await fetch("https://api.sse.cisco.com/admin/v2" + href + "/credentials", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": "Bearer " + accessToken
                    },
                    body: JSON.stringify(credentialsPayload)
                });
 
                const credData = await credResp.json();
                resultDiv.innerHTML += "<br/><span class='success'>✅ Credentials added successfully! Webhook: " + webhook + "</span>";
				window.location.href = window.location.origin
 
            } catch (error) {
                resultDiv.innerHTML += "<br/><span class='error'>Error: " + error + "</span>";
            }
        }
		</script>
	</body>

	</html>
