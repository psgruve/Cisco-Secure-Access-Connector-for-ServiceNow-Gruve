        <html><![CDATA[<jelly>
	<html>

	<head>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
		<style>
			body {
				background: #f4f5f7;
				font-family: 'Segoe UI', Tahoma, sans-serif;
			}

			.form-container {
				max-width: 600px;
				margin: 60px auto;
				padding: 30px;
				background: #fff;
				border: 1px solid #d1d1d1;
				border-radius: 10px;
				box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
			}

			/* Stepper container */
			.stepper {
				display: flex;
				justify-content: space-between;
				position: relative;
				margin-bottom: 25px;
			}

			/* Progress line background */
			.stepper::before {
				content: "";
				position: absolute;
				top: 18px;
				left: 15%;
				right: 15%;
				height: 3px;
				background: #e0e0e0;
				z-index: 0;
			}

			/* Progress fill line */
			.progress-line {
				position: absolute;
				top: 18px;
				left: 15%;
				height: 3px;
				background: #007bff;
				z-index: 1;
				transition: width 0.3s ease;
			}

			.step {
				flex: 1;
				text-align: center;
				position: relative;
				z-index: 2;
			}

			.step .circle {
				width: 36px;
				height: 36px;
				line-height: 36px;
				border-radius: 50%;
				display: inline-block;
				background: #d3d3d3;
				color: white;
				font-weight: bold;
				transition: background 0.3s ease;
			}

			.step.active .circle {
				background: #007bff;
			}

			.step.completed .circle {
				background: #28a745;
			}

			.step p {
				margin-top: 8px;
				font-size: 14px;
				color: #333;
			}

			/* Divider between stepper and form */
			.divider {
				height: 1px;
				background: #ddd;
				margin: 20px 0;
			}

			h2 {
				text-align: center;
				margin-bottom: 20px;
				font-size: 22px;
				font-weight: 700;
				color: #007bff;
			}

			.form-group {
				margin-bottom: 20px;
			}

			.form-group label {
				display: block;
				font-weight: 600;
				margin-bottom: 6px;
				color: #333;
			}

			.form-control {
				width: 100%;
				padding: 12px;
				border: 1px solid #c0c0c0;
				border-radius: 6px;
				font-size: 15px;
			}

			.form-control:focus {
				border-color: #0072c6;
				outline: none;
				box-shadow: 0 0 4px rgba(0, 114, 198, 0.3);
			}

			.btn-primary {
				background-color: #0056b3;
				border: none;
				padding: 12px;
				color: #fff;
				font-weight: bold;
				border-radius: 6px;
				cursor: pointer;
				width: 100%;
				font-size: 16px;
			}

			.btn-primary:hover {
				background-color: #004a99;
			}

			#result,
			#resultMsg {
				margin-top: 15px;
				font-weight: bold;
				text-align: center;
			}
			 .instructions {
                background: #f9fafb;
                border: 1px solid #e0e0e0;
                border-radius: 8px;
                padding: 25px;
                margin-bottom: 35px;
            }
 
            .instructions h3 {
                font-size: 20px;
                margin-bottom: 15px;
                color: #333;
            }
 
            .instructions ol {
                padding-left: 20px;
                margin: 0;
            }
 
            .instructions li {
                margin-bottom: 12px;
                line-height: 1.7;
                font-size: 15px;
                color: #444;
            }
 
            .instructions strong {
                color: #293e40;
            }

			.error {
				color: red;
			}

			.success {
				color: green;
			}
		</style>
	</head>

	<body>
		<div class="form-container">

			<div class="stepper">
				<div class="progress-line" id="progressLine" style="width:20%"></div>
				<div class="step active" id="stepper1">
					<span class="circle">1</span>
					<p>Cisco Secure Access Credentials</p>
				</div>
				<div class="step" id="stepper2">
					<span class="circle">2</span>
					<p>Service now alert Registration</p>
				</div>
			</div>

			<div class="divider"></div>
			<!-- Step 1 -->
			<div id="step1">
				<h2>Cisco Seure Access App Credentials</h2>
				<form onsubmit="submitCiscoSecureAccessConfig(); return false;">
					<div class="form-group">
						<label for="client_key">Client Key</label>
						<input class="form-control" type="text" id="client_key" name="client_key"
							placeholder="Enter your Client Key" required="required" />
					</div>
					<div class="form-group">
						<label for="client_secret">Client Secret</label>
						<input class="form-control" type="password" id="client_secret" name="client_secret"
							placeholder="Enter your Client Secret" required="required" />
					</div>
					<button type="submit" class="btn-primary">Submit</button>
				</form>
				<div id="result"></div>
			</div>

			<!-- Step 2 -->
			<div id="step2" style="display:none;">
				<h2>Webhook Credentials</h2>
				 <div class="instructions">
                <h3>Instructions</h3>
                <ol>
                    <li>Ask your administrator to create a dedicated ServiceNow user account for receiving Cisco Secure Access alerts.
                    </li>
                    <li>Note the ServiceNow Username and Password for the new account. Enter carefully; incorrect
                        credentials cannot be verified.</li>
                    <li>Fill in your credentials below and click Submit to register for Cisco Secure Access Event Alerts. A confirmation
                        message will appear upon success.</li>
                </ol>
            </div>
				<form onsubmit="submitForm(); return false;">
					<div class="form-group">
						<label for="username">Username</label>
						<input class="form-control" type="text" id="username" name="username" required="required" />
					</div>
					<div class="form-group">
						<label for="password">Password</label>
						<input class="form-control" type="password" id="password" name="password" required="required" />
					</div>
					<div class="form-group">
						<label for="cnf_password">Confirm Password</label>
						<input class="form-control" type="password" id="cnf_password" name="cnf_password"
							required="required" />
					</div>
					<button type="submit" class="btn-primary">Submit</button>
				</form>
				<div id="resultMsg"></div>
			</div>

		</div>
		<script>
			function setStepStatus(stepNum, status) {
    const stepEl = document.getElementById("stepper" + stepNum);
    stepEl.classList.remove("active", "completed");
 
    // Set the step status
    stepEl.classList.add(status); // 'active' or 'completed'
 
    // Update progress line width based on step number
    const progressLine = document.getElementById("progressLine");
    switch(stepNum) {
        case 1:
            progressLine.style.width = (status === "completed") ? "50%" : "20%";
            break;
        case 2:
            progressLine.style.width = (status === "completed") ? "100%" : "50%";
            break;
    }
}
 
 
function submitCiscoSecureAccessConfig() {
    var clientKey = document.getElementById("client_key").value;
      var clientSecret = document.getElementById("client_secret").value;
 
      if (!clientKey || !clientSecret) {
        document.getElementById("result").innerHTML =
          '<div style="color:red;">❌ Please enter both Client Key and Secret.</div>';
        return;
      }
 
      var ga = new GlideAjax("CiscoSecureAccessCredentials");
      ga.addParam("sysparm_name", "createProfileAndFetchToken");
      ga.addParam("client_key", clientKey);
      ga.addParam("client_secret", clientSecret);
 
      document.getElementById("result").innerHTML =
        '<div style="color:orange;">⏳ Fetching token...</div>';
 
      ga.getXMLAnswer(function(response) {
        if (response) {
          document.getElementById("result").innerHTML =
            '<div style="color:green;">' + response + '</div>';
 
            setStepStatus(1, "completed");
            setStepStatus(2, "active");
           
            document.getElementById("step1").style.display = "none";
            document.getElementById("step2").style.display = "block";
        } else {
          document.getElementById("result").innerHTML =
            '<div style="color:red;">No response received. Check logs.</div>';
        }
      });
}
 
      window.onload = function() {
                const savedUsername = localStorage.getItem('savedUsername');
                if (savedUsername) {
                     document.getElementById('username').value = savedUsername;
                 }
        };
       async function submitForm() {
    const username = document.getElementById('username').value;
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('cnf_password').value;
    const resultDiv = document.getElementById('resultMsg');
    localStorage.setItem('savedUsername', username);

    // Step 1: fetch webhook url (you already do this)
    let apiInfo;
    try {
        apiInfo = await new Promise(function (resolve, reject) {
            var ga = new GlideAjax('CiscoSecureAccessGetWebhookUrl');
            ga.addParam('sysparm_name', 'getApiInfo');
            ga.addParam('sysparm_api_name', 'Cisco Secure Access Event Management');
            ga.getXMLAnswer(function (response) {
                try {
                    resolve(JSON.parse(response));
                } catch (e) { reject(e); }
            });
        });
    } catch (err) {
        resultDiv.innerHTML = "Error fetching API info: " + err;
        resultDiv.className = 'error';
        return;
    }
    if (apiInfo.error) {
        resultDiv.innerHTML = apiInfo.error;
        resultDiv.className = 'error';
        return;
    }
    const webhook = apiInfo.full_url;

    // Step 2: Validate password in client
    if (password !== confirmPassword) {
        resultDiv.innerHTML = "<span class='error'>Passwords do not match!</span>";
        return;
    }

    // Step 3: Call server Script Include via GlideAjax to perform the REST calls
    resultDiv.innerHTML = 'Processing...';
    var ga2 = new GlideAjax('CiscoSecureAccessIntegrationAjax');
    ga2.addParam('sysparm_name', 'createIntegration');
    ga2.addParam('sysparm_username', username);
    ga2.addParam('sysparm_password', password);
    ga2.addParam('sysparm_webhook', webhook);

    ga2.getXMLAnswer(function(response) {
        // response is a JSON string from server
        try {
            var res = JSON.parse(response);
        } catch (e) {
            resultDiv.innerHTML = "<span class='error'>Invalid server response</span>";
            return;
        }

        if (res.success) {
            resultDiv.innerHTML = "<span class='success'>✅ " + res.message + "</span>";
            resultDiv.innerHTML += "<div>Webhook: " + res.webhook + "</div>";
            // optionally show raw responses (trimmed)
            // resultDiv.innerHTML += "<pre>" + JSON.stringify(res.integrationResponse, null, 2) + "</pre>";
            // redirect if needed
            window.location.href = window.location.origin;
        } else {
            resultDiv.innerHTML = "<span class='error'>Error: " + res.message + "</span>";
            if (res.body) {
                resultDiv.innerHTML += "<pre>" + res.body + "</pre>";
            }
        }
    });
}
		</script>
	</body>

	</html>
</jelly>]]></html>
